rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // weeks/{yyyy-mm-dd of Monday}/meals/{mon-am | mon-pm | ... | sun-pm}
    match /weeks/{week}/meals/{meal} {
      allow read, delete: if request.auth != null
        && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');

      allow create, update: if request.auth != null
        && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && meal.matches('^(mon|tue|wed|thu|fri|sat|sun)-(am|pm)$')
        && request.resource.data.keys().hasOnly(['name', 'by', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.by is string
        && request.resource.data.at is timestamp;
    }

    match /accessLogs/{logId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'accessedAt', 'ipAddress', 'userAgent', 'language', 'timeZone'])
        && request.resource.data.keys().hasAll(['uid', 'accessedAt', 'userAgent', 'language', 'timeZone'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.accessedAt == request.time
        && (!('ipAddress' in request.resource.data)
          || (request.resource.data.ipAddress is string
            && request.resource.data.ipAddress.size() <= 45))
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 512
        && request.resource.data.language is string
        && request.resource.data.language.size() <= 100
        && request.resource.data.timeZone is string
        && request.resource.data.timeZone.size() <= 100;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
